---
interface Props {
  onClick?: () => void;
  type?: ButtonHTMLAttributes["type"];
  class?: string;
  variant?: "contained" | "outlined" | "text";
}

const {
  onClick,
  type = "button",
  class: buttonClass,
  variant = "contained",
} = Astro.props;
---

<button
  onClick={onClick}
  type={type}
  class:list={["button", variant, buttonClass]}
>
  <slot />

  <style>
    .button {
      font-weight: 500;
      font-size: 16px;
      line-height: 1.3;
      padding: 12px 0;
      border-radius: 100px;
      width: 286px;
      border: 1px solid transparent;
    }

    .contained {
      color: var(--text-color-primary);
      background: linear-gradient(90deg, #3f8cff 0%, #4639fe 100%);
      border: none;
    }

    .contained:hover {
      background: linear-gradient(90deg, #3d80ff 0%, #003dbe 100%);
    }

    .outlined {
      color: var(--text-color-accent-blue);
      background:
        linear-gradient(var(--bg-color), var(--bg-color)) padding-box,
        linear-gradient(90deg, #3d80ff 0%, #003dbe 100%) border-box;
    }

    .outlined:hover {
      background:
        linear-gradient(var(--bg-color), var(--bg-color)) padding-box,
        linear-gradient(90deg, #3d80ff 0%, #003dbe 100%) border-box;
      filter: brightness(1.1);
    }
  </style>
</button>
