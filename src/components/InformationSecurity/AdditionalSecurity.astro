---
const cards = [
  {
    icon: "/icons/cpu.svg",
    name: "Защита данных на уровне ОС",
    text: "Неизвлекаемые ключи и криптографические механизмы с защитой от утечек и взлома.",
  },
  {
    icon: "/icons/center.svg",
    name: "Аврора Центр",
    text: "Управление доступом и политиками безопасности через единую точку администрирования.",
  },
  {
    icon: "/icons/world.svg",
    name: "Цифровой суверенитет",
    text: "Отечественная разработка, полностью независимая от иностранных компаний и санкций.",
  },
  {
    icon: "/icons/guard.svg",
    name: "Доверенная среда",
    text: "Поддержка сертифицированных приложений и удаленная доставка обновлений без участия пользователя.",
  },
];
---

<div class="container">
  <header class="header">
    <img src="/icons/avrora.svg" alt="" class="image" />
    <div class="text-container">
      <h3 class="title">
        Дополнительная безопасность<br /><span class="color-gradient-blue"
          >с операционной системой «Аврора»</span
        >
      </h3>
      <p class="text">
        Управляйте бесперебойной работой мобильной инфраструктуры с<br />помощью
        первой отечественной мобильной операционной системы.
      </p>
    </div>
  </header>

  <div class="content">
    {
      cards.map(({ icon, name, text }) => (
        <article class="card">
          <img src={icon} alt="" class="card__icon" />
          <div class="card__textContainer">
            <h4 class="card__title ">{name}</h4>
            <p class="card__text">{text}</p>
          </div>
        </article>
      ))
    }

    <article class="card bigCard">
      <h4 class="card__title">ФСТЭК России</h4>
      <p class="card__text">
        Сертификат ФСТЭК подтверждает безопасность платформы «Аврора Центр» и ОС
        «Аврора» по 4 уровню доверия. Это позволяет использовать решение в
        системах с самыми высокими требованиями к защите информации.
      </p>
      <ul class="big-card__list">
        <li class="listItem">Защищенный жизненный цикл ПО</li>
        <li class="listItem">Контроль целостности на уровне ядра</li>
        <li class="listItem">Отечественная криптография</li>
      </ul>
    </article>
  </div>
  <style>
    .container {
      display: flex;
      flex-direction: column;
      width: 100%;
      margin-top: 100px;
      padding-top: 100px;
      row-gap: 80px;
      border-top: 1px solid transparent;
      border-image: linear-gradient(
          90deg,
          #3b82f600 0%,
          #3b82f680 50%,
          #3b82f600 100%
        )
        1;
    }

    .text-container {
      display: flex;
      flex-direction: column;
      row-gap: 24px;
    }

    .text {
      font-weight: 500;
      color: var(--text-color-secondary);
    }

    .image {
      filter: drop-shadow(0 -4px 30px #3b82f666);
    }

    .header {
      display: flex;
      column-gap: 80px;
      width: 100%;
    }

    .content {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.2fr);
      grid-template-rows: repeat(2, minmax(160px, auto));
      grid-template-areas:
        "card1 card2 bigCard"
        "card3 card4 bigCard";
      gap: 12px;
      width: 100%;
    }

    .card:nth-child(1) {
      grid-area: card1;
    }

    .card:nth-child(2) {
      grid-area: card2;
    }

    .card:nth-child(3) {
      grid-area: card3;
    }

    .card:nth-child(4) {
      grid-area: card4;
    }

    .card {
      min-width: 0;
      border-radius: 20px;
      border: 1px solid transparent;
      padding: 20px;
      background:
        linear-gradient(180deg, #09154566 40%, #010619 100%) padding-box,
        linear-gradient(#010619, #010619) padding-box,
        linear-gradient(90deg, #0036a8 0%, #0052ff 50%, #0c41b4 100%) border-box;
      display: flex;
      column-gap: 24px;
    }

    .card__title {
      font-size: 22px;
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: 12px;
    }

    .bigCard {
      grid-area: bigCard;
      flex-direction: column;
      padding: 32px;
      row-gap: 24px;
    }

    .card__icon {
      width: 68px;
      height: 68px;
      object-fit: contain;
    }

    .card__text {
      color: var(--text-color-secondary);
      line-height: 1.3;
      font-size: 14px;
    }

    .big-card__list {
      display: flex;
      flex-direction: column;
      row-gap: 10px;
    }

    .listItem {
      display: flex;
      column-gap: 12px;
      color: var(--text-color-secondary);
      font-size: 14px;
      line-height: 1.3;
      align-items: center;
    }

    .listItem::before {
      content: "";
      flex: 0 0 8px;
      width: 8px;
      height: 8px;
      background: linear-gradient(90deg, #3d80ff 0%, #003dbe 100%);
      border-radius: 50%;
    }
  </style>
</div>
