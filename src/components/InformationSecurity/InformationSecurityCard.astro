---
interface CardProps {
  title: string;
  image: string;
  points: string[];
}

const { title, image, points } = Astro.props as CardProps;
---

<article class="card">
  <img src={image} alt="" class="image" loading="lazy" decoding="async" />
  <div class="content">
    <h4 class="title">{title}</h4>
    <ul class="pointsList">
      {
        points.map((point) => {
          return <li class="point">{point}</li>;
        })
      }
    </ul>
  </div>

  <style>
    .card {
      border-radius: 20px;
      border: 1px solid transparent;
      overflow: hidden;
      background:
        linear-gradient(180deg, #09154566 40%, #010619 100%) padding-box,
        linear-gradient(#010619, #010619) padding-box,
        linear-gradient(
            90deg,
            #0036a8 0%,
            #001020 14.29%,
            #0052ff 28.57%,
            #769fff 42.86%,
            #0c41b4 57.14%,
            #0052ff 71.43%,
            #0649d8 85.71%,
            #0c41b4 100%
          )
          border-box;
    }

    .content {
      display: flex;
      flex-direction: column;
      row-gap: 16px;
      padding: 24px;
    }

    .pointsList {
      display: flex;
      flex-direction: column;
      row-gap: 12px;
    }

    .point {
      display: flex;
      align-items: center;
      column-gap: 16px;
      color: var(--text-color-secondary);
      font-size: 14px;
      line-height: 1.3;
    }

    .point::before {
      content: "";
      flex: 0 0 4px;
      width: 4px;
      height: 4px;
      background-color: var(--text-color-accent-blue);
      border-radius: 50%;
    }

    .image {
      width: 100%;
      height: 292px;
      max-height: 292px;
      object-fit: cover;
      object-position: center;
    }
  </style>
</article>
