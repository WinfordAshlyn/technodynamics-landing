---
interface Props {
  name: string;
  text: string;
  icon: string;
}

const { name, text, icon } = Astro.props;
---

<div class="card">
  <img
    class="card__icon"
    src={icon}
    alt=""
    width="40"
    height="40"
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="text">
    <h3 class="card__title">{name}</h3>
    <p class="card__paragraph">{text}</p>
  </div>
</div>

<style>
  .card {
    display: flex;
    gap: 20px;
    background-color: transparent;
    align-items: flex-start;
    flex-wrap: nowrap;
    min-width: 205px;
  }

  .card__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .text {
    display: flex;
    flex-direction: column;
    row-gap: 4px;
    color: var(--text-color-accent-blue);
  }

  .card__title {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
  }

  .card__paragraph {
    font-size: 14px;
    white-space: pre-line;
  }
</style>
