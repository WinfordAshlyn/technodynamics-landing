---
import QuickStartCard from "./QuickStartCard.astro";

const cards = [
  {
    icon: "/icons/stack.svg",
    title: "Источники данных",
    points: [
      "Подключение к вашей системе ЭДО",
      "Выгрузка данных по расписанию",
      "Обмен данными — по стандартным интерфейсам",
    ],
  },
  {
    icon: "/icons/server.svg",
    title: "Ядро системы",
    points: [
      "Серверная часть, полностью готовая к использованию",
      "Передача больших объемов данных без нагрузки на основную базу",
      "Шифрование данных",
      "Синхронизация не требует доработок",
    ],
  },
  {
    icon: "/icons/phone.svg",
    title: "Мобильное приложение",
    points: [
      "Авторизация и аутентификация пользователей",
      "Онлайн и офлайн доступ к данным",
      "Уведомления",
    ],
  },
];

const contentPoints = [
  "Полная интеграция с корпоративной IT-инфраструктурой",
  "1 интегратор для всей системы",
  "Отработанные процессы внедрения и фиксированная стоимость",
  "Поддержка от нашей команды до и после старта",
];
---

<section class="section">
  <h2 class="title" id="quickStart">
    Легкий старт<br /><span class="color-gradient-blue">без изменений</span> в процессах
  </h2>
  <p class="text">
    Архитектура решения позволяет интегрироваться в существующую инфраструктуру<br
    />
    за считанные дни.
  </p>

  <ul class="cardsList">
    {
      cards.map(({ title, icon, points }) => {
        return (
          <li>
            <QuickStartCard title={title} icon={icon} points={points} />
          </li>
        );
      })
    }
  </ul>

  <div class="content">
    <div class="content__grid">
      <h3 class="content__title content__title--left">
        Запуск за <span class="color-gradient-blue">2-4 недели </span>
      </h3>
      <p class="content__text content__text--left">
        Наше решение сокращает время на разработку и<br />ее стоимость в 4–6
        раз. Получите готовое<br />мобильное приложение без разработки «с нуля».
      </p>
      <ul class="content__points">
        {
          contentPoints.map((point) => {
            return (
              <li class="content__point">
                <img
                  class="content__point-icon"
                  src="/icons/listItemIcon.svg"
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                />
                <span>{point}</span>
              </li>
            );
          })
        }
      </ul>
      <h3 class="content__title content__title--right">Решение под ключ</h3>
      <p class="content__text content__text--right">
        По запросу мы предоставим полноценное рабочее место на<br />базе ОС
        «Аврора» — преднастроенные смартфоны или<br />планшеты, полностью
        готовые к работе в вашей<br />инфраструктуре.
      </p>

      <div class="recomended-container">
        <div class="recomended">
          <div class="recomended__point"></div>
          <span class="recomended__text">Рекомендуем</span>
        </div>
        <img
          src="/images/quickStart/cutPhones.png"
          alt=""
          class="recomended__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <style>
    .title {
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 24px;
    }

    .text {
      color: var(--text-color-secondary);
      text-align: center;
      margin-bottom: 120px;
      line-height: 1.3;
    }

    .cardsList {
      display: flex;
      align-items: stretch;
      width: 100%;
      margin-bottom: 100px;
    }

    .cardsList > li {
      flex: 1 1 0;
      min-width: 0;
    }

    .recomended-container {
      grid-area: recomended;
      position: relative;
      width: 100%;
      min-width: 0;
      align-self: stretch;
      justify-self: stretch;
    }

    .recomended {
      position: relative;
      z-index: 1;
      padding: 10px;
      display: flex;
      margin-left: auto;
      border-radius: 20px;
      align-items: center;
      justify-content: end;
      gap: 8px;
      background: transparent;
      width: fit-content;
    }

    .recomended::before {
      content: "";
      position: absolute;
      inset: 0;
      padding: 1px;
      border-radius: inherit;
      background: linear-gradient(
        90deg,
        #0036a8 0%,
        #001020 14.29%,
        #0052ff 28.57%,
        #769fff 42.86%,
        #0c41b4 57.14%,
        #0052ff 71.43%,
        #0649d8 85.71%,
        #0c41b4 100%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
    }

    .recomended__point {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--text-color-accent-blue);
    }

    .recomended__text {
      font-weight: 500;
      color: var(--text-color-accent-blue);
    }

    .recomended__img {
      position: absolute;
      left: 0;
      right: 0;
      bottom: -40px;
      width: 100%;
      max-width: none;
      height: auto;
    }

    .content {
      border-radius: 20px;
      border: 1px solid transparent;
      padding: 40px;
      width: 100%;
      background:
        linear-gradient(180deg, #09154566 40%, #010619 100%) padding-box,
        linear-gradient(#010619, #010619) padding-box,
        linear-gradient(
            90deg,
            #0036a8 0%,
            #001020 14.29%,
            #0052ff 28.57%,
            #769fff 42.86%,
            #0c41b4 57.14%,
            #0052ff 71.43%,
            #0649d8 85.71%,
            #0c41b4 100%
          )
          border-box;
    }

    .content__grid {
      display: grid;
      grid-template-columns: max-content max-content;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "left-title right-title"
        "left-text right-text"
        "content-points recomended";
      column-gap: 88px;
      row-gap: 24px;
      width: fit-content;
    }

    .content__title--left {
      grid-area: left-title;
    }

    .content__title--right {
      grid-area: right-title;
      align-self: end;
    }

    .content__text {
      font-weight: 500;
      color: var(--text-color-secondary);
    }

    .content__text--left {
      grid-area: left-text;
      align-self: end;
    }

    .content__text--right {
      grid-area: right-text;
    }

    .content__points {
      display: flex;
      flex-direction: column;
      grid-area: content-points;
      row-gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .content__point {
      display: flex;
      align-items: center;
      column-gap: 8px;
      font-weight: 500;
      color: var(--text-color-secondary);
    }

    .content__point-icon {
      flex: 0 0 24px;
      width: 24px;
      height: 24px;
    }
  </style>
</section>
