---
import AccessToDataSectionCard from "./AccessToDataSectionCard.astro";

const cards = [
  { name: "Командировки", icon: "/icons/assignments.svg" },
  { name: "Перелеты", icon: "/icons/flights.svg" },
  { name: "Встречи", icon: "/icons/meetings.svg" },
];
---

<div class="work-rhythm">
  <div class="left-column">
    <h3 class="work-rhythm__title">
      Реальность<br />современного <span class="color-gradient-blue"
        >рабочего<br />ритма</span
      >
    </h3>
    <p class="work-rhythm__text">
      Бизнес требует оперативного и безопасного доступа к данным, независимо от
      вашего местоположения. Когда сотрудники не могут работать с документами
      вне офиса, бизнес теряет деньги, а сотрудники — время
    </p>
    <ul class="cards">
      {
        cards.map(({ name, icon }) => (
          <li>
            <AccessToDataSectionCard name={name} icon={icon} />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="right-column">
    <img
      src="/images/accessToData/AccessToDataSectionImage.jpg"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .work-rhythm {
    display: flex;
    column-gap: 80px;
    justify-content: space-between;
  }

  .work-rhythm__title {
    margin-bottom: 20px;
  }

  .left-column {
    flex: 0 0 538px;
    width: 538px;
    display: flex;
    flex-direction: column;
  }

  .right-column {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 20px;
    display: flex;
    align-self: flex-start;
  }

  .right-column img {
    display: block;
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .cards {
    display: flex;
    flex-direction: row;
    column-gap: 16px;
    margin-top: auto;
  }

  .work-rhythm__text {
    color: var(--text-color-secondary);
    line-height: 1.3;
    margin-bottom: 75px;
  }
</style>
