---
const { name, text, image, id } = Astro.props;
---

<div class="container">
  <span class="number">[ {id} ]</span>
  <div class="image-container">
    <img src={image} alt="" loading="lazy" decoding="async" />
  </div>

  <footer class="footer">
    <h4 class="title">{name}</h4>
    <p class="text">{text}</p>
  </footer>

  <style>
    .container {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 20px;
      border: 1px solid transparent;
      position: relative;
      background:
        linear-gradient(180deg, #09154566 40%, #010619 100%) padding-box,
        linear-gradient(#010619, #010619) padding-box,
        linear-gradient(
            90deg,
            #0036a8 0%,
            #001020 14.29%,
            #0052ff 28.57%,
            #769fff 42.86%,
            #0c41b4 57.14%,
            #0052ff 71.43%,
            #0649d8 85.71%,
            #0c41b4 100%
          )
          border-box;
    }

    .number {
      position: absolute;
      z-index: 1;
      transform: translate(50%, 50%);
      font-weight: 500;
      line-height: 1.3;
      color: var(--text-color-secondary);
    }

    .image-container {
      width: 100%;
      overflow: hidden;
      flex-shrink: 0;
    }

    .image-container img {
      display: block;
      width: 100%;
      height: auto;
    }

    .title {
      color: var(--text-color-primary);
    }

    .text {
      color: var(--text-color-secondary);
      font-size: 14px;
      line-height: 1.3;
    }

    .footer {
      display: flex;
      flex-direction: column;
      row-gap: 8px;
      padding: 24px;
    }
  </style>
</div>
