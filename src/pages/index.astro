---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero/Hero.astro";
import AccessToDataSection from "../components/AccessToDataSection/AccessToDataSection.astro";
import MobileWorkSpace from "../components/MobileWorkSpace/MobileWorkSpace.astro";
import InformationSecurity from "../components/InformationSecurity/InformationSecurity.astro";
import QuickStart from "../components/QuickStart/QuickStart.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <AccessToDataSection />
    <MobileWorkSpace />
    <InformationSecurity />
    <QuickStart />
  </main>
  <Footer />

  <script>
    document.addEventListener("dragstart", (event) => {
      if (event.target instanceof HTMLImageElement) {
        event.preventDefault();
      }
    });
  </script>
</Layout>
